# Rename this file to .env and fill in real values. Never commit .env.

# --- Firebase Admin SDK ---
# Download a service account key from Firebase Console > Project Settings
# > Service Accounts > Generate new private key, and point this at the file.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# --- JWT Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
